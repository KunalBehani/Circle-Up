# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local URI)
# In development, if left blank, CircleUp automatically starts an in-memory MongoDB server
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/circleup?retryWrites=true&w=majority

# JWT Authentication Secret and Expiry
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Client URL)
CLIENT_URL=http://localhost:5173
